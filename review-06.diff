+++    at tmp_path, and the caller PATH stays minimal (/usr/bin:/bin) — the converge-style env."""
+++    import hermes_cli.gateway as gateway_cli
+++
+++    monkeypatch.setattr(Path, "home", staticmethod(lambda: tmp_path))
+++    home = tmp_path / ".hermes"
