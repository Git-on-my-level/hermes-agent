++++++def _installed_plist_path_dirs(plist_path: Path) -> list[str]:
++++++    """PATH entries baked into the installed plist at *plist_path*; ``[]`` when absent/unreadable."""
++++++    try:
++++++        import plistlib
++++++        with plist_path.open("rb") as fh:
++++++            installed = plistlib.load(fh)
