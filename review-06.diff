++++def _make_dir(path: Path) -> str:
++++    path.mkdir(parents=True, exist_ok=True)
++++    return str(path)
++++
++++
++++@pytest.fixture
++++def gateway_cli():
++++    import hermes_cli.gateway as gateway_cli
++++
++++    return gateway_cli
++++
